# Copy to .env for local development.
DEBUG=True
SECRET_KEY=change-me

# Neon Postgres — use the *pooled* connection string (host contains "-pooler").
# Leave unset to use a local SQLite file.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/healthops?sslmode=require&channel_binding=require

# Comma separated
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
CSRF_TRUSTED_ORIGINS=https://*.onrender.com
SITE_URL=http://127.0.0.1:8000

# Clinic locale
TIME_ZONE=UTC
CURRENCY_SYMBOL=$

# Email (optional — without EMAIL_HOST, emails print to the console)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=HealthOPS Connect <no-reply@example.com>

# Object storage for uploads (Neon Object Storage, S3-compatible). Leave
# AWS_STORAGE_BUCKET_NAME empty to keep uploads on the local disk.
AWS_STORAGE_BUCKET_NAME=
AWS_ENDPOINT_URL_S3=https://br-xxxx.storage.c-N.REGION.aws.neon.tech
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=nak_live_...
AWS_SECRET_ACCESS_KEY=nsk_live_...

# Seed demo data during the Render build (see build.sh)
SEED_DEMO=false
