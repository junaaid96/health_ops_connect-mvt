{
  "name": "health-ops-connect",
  "private": true,
  "description": "Frontend build for HealthOPS Connect (Tailwind CSS + vendored JS).",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/css/app.css -o ./static/css/app.css --minify",
    "watch:css": "tailwindcss -i ./assets/css/app.css -o ./static/css/app.css --watch",
    "vendor": "node ./assets/vendor.mjs",
    "build": "npm run vendor && npm run build:css"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "htmx.org": "^2.0.11",
    "alpinejs": "^3.17.4",
    "chart.js": "^4.5.1",
    "lucide-static": "^1.48.0"
  }
}
